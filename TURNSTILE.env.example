# Backend: keep empty in local development if Turnstile is not being used yet.
# Never expose this value in the frontend.
TURNSTILE_SECRET_KEY=

# Optional: reject valid tokens whose hostname does not match this value.
# Example for a deployed site: app.example.com
TURNSTILE_EXPECTED_HOSTNAME=

# Frontend: public site key. It is safe to expose in the browser.
# For Vite, place this in the web app environment.
VITE_TURNSTILE_SITE_KEY=
