# Plantilla de apps/web/.env.local (opcional). Vite solo expone las variables con prefijo VITE_.

# URL base de la API (http://localhost:3000 si no se indica). En un despliegue con la API bajo el
# mismo dominio (reescritura /api/* en Vercel), déjala vacía: VITE_API_URL= usa rutas relativas.
VITE_API_URL="http://localhost:3000"

# Clave pública de Cloudflare Turnstile. Vacía = los formularios no muestran el widget.
# Configúrala junto con TURNSTILE_SECRET_KEY en apps/api/.env.
VITE_TURNSTILE_SITE_KEY=""
