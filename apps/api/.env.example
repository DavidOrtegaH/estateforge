# Plantilla de apps/api/.env. Copia este fichero a .env y rellena los valores.
# No subas nunca el .env real al repositorio. Detalle de cada variable en el README.

# --- Obligatorias para arrancar la API (src/env.ts y src/db/prisma.ts) ---
# Conexión PostgreSQL. Ejemplo sin credenciales reales: postgresql://usuario:contraseña@localhost:5432/estateforge
# En un servidor remoto, añade los parámetros SSL que exija la plataforma (por ejemplo, ?sslmode=require).
DATABASE_URL=
# Base de sombra de `prisma migrate dev` (opcional). Con ella, el rol de desarrollo no necesita CREATEDB.
SHADOW_DATABASE_URL=
# Pool de conexiones (opcionales): máximo (10), espera de conexión en ms (5000), inactividad en ms (30000).
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_MS=
DATABASE_IDLE_TIMEOUT_MS=
# Nombre de las conexiones en pg_stat_activity (estateforge-api).
DATABASE_APPLICATION_NAME=
# Dirección HTTP de la API (opcionales): puerto (3000) e interfaz (localhost).
PORT=
HOST=
# Solo para desarrollo: contraseña de la cuenta de ejemplo de `pnpm --filter api db:seed`.
SEED_USER_PASSWORD=
# Solo para pruebas de integración: servidor PostgreSQL local con permiso para crear bases.
TEST_POSTGRES_ADMIN_URL=

# --- Opcionales (valores por defecto entre paréntesis) ---
# Origen permitido por CORS: la URL de la web (http://localhost:5173).
CORS_ORIGIN="http://localhost:5173"
# URL de la web en los enlaces de los correos (http://localhost:5173).
WEB_APP_URL="http://localhost:5173"
# URL pública de la API en el enlace del aviso de incidente (http://localhost:3000).
API_PUBLIC_URL="http://localhost:3000"

# --- Inteligencia artificial: BYOK obligatorio (DA-77) ---
# EstateForge NO usa claves de proveedores de IA en el servidor. No existe ninguna variable para
# ellas: si en tu entorno quedan GEMINI_API_KEY, OPENAI_API_KEY o AI_PROVIDER de versiones
# anteriores, la API las ignora (ni las lee ni las migra) y puedes retirarlas. Cada usuario
# configura su propia API key en Ajustes y su proveedor le factura el consumo.
#
# La variable siguiente NO es una clave de un proveedor de IA: es la clave interna con la que
# EstateForge cifra (AES-256-GCM) las API keys que guardan los usuarios. No da acceso a ningún
# servicio de IA y no genera ningún coste. Sin ella no se puede guardar ninguna API key.
# Debe tener exactamente 32 bytes, codificados en base64 o en hexadecimal.
ESTATEFORGE_API_KEY_ENCRYPTION_KEY="tu_api_key_encryption_key_aqui"

# --- Correo (obligatorias para enviar emails; si falta alguna, el envío falla) ---
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
# Remitente, por ejemplo: EstateForge <no-reply@tu-dominio.com>
SMTP_FROM=""
# Puerto SMTP (587). SMTP_SECURE: true o false; si se deja vacío, true solo con el puerto 465.
SMTP_PORT="587"
SMTP_SECURE=""
# Contacto de soporte que se añade a algunos correos (opcional).
SUPPORT_EMAIL=""

# --- Cloudflare Turnstile (opcional; vacío = sin verificación, para desarrollo) ---
TURNSTILE_SECRET_KEY=""
# Si se indica, rechaza tokens de otro hostname. Ejemplo: app.example.com
TURNSTILE_EXPECTED_HOSTNAME=""

# --- Verificación del email (Fase 0) ---
# Fecha ISO 8601 con zona horaria desde la que las cuentas nuevas deben verificar su email
# antes de acceder. Las creadas antes son "existentes". Vacía: no se exige a nadie.
EMAIL_VERIFICATION_REQUIRED_FROM=""
# Fecha ISO 8601 hasta la que las cuentas existentes sin verificar pueden seguir entrando.
# Vacía: el periodo de gracia no termina. Requiere EMAIL_VERIFICATION_REQUIRED_FROM.
EMAIL_VERIFICATION_GRACE_UNTIL=""
# Horas de validez del enlace de verificación, de 1 a 168 (24).
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=""

# --- Entorno (development) ---
# Con production, la cookie de sesión lleva Secure (requiere HTTPS).
NODE_ENV="development"

# --- Almacenamiento de fotografías, carteles, vídeos y pistas (DA-46, DA-58) ---
# Los archivos nunca se guardan en PostgreSQL. local (por defecto en desarrollo) o vercel-blob.
# STORAGE_PROVIDER se admite como sinónimo (si se definen las dos, deben coincidir).
# Con VERCEL=1 o NODE_ENV=production el modo local impide arrancar: el disco de una función no es
# persistente. Con vercel-blob sin credenciales, la API tampoco arranca.
STORAGE_DRIVER=
# Carpeta del modo local (apps/api/.storage si se deja vacía; está en .gitignore).
STORAGE_LOCAL_DIR=
# 1 = el disco local se comporta como Vercel Blob: URLs firmadas hacia /api/local-blob/* y subidas
# directas (preparar, PUT firmado, confirmar). Vacía = la API recibe y sirve los archivos.
STORAGE_LOCAL_SIGNED_URLS=
# Secreto HMAC de esas URLs locales (aleatorio en cada arranque si se deja vacío). Solo desarrollo.
STORAGE_LOCAL_SIGNING_SECRET=
# 1 = permite el disco local con NODE_ENV=production fuera de Vercel (servidor con disco persistente).
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=
# Solo con vercel-blob y solo en el backend (nunca con prefijo VITE_). La crea Vercel al conectar
# un Blob store privado al proyecto; alternativa: OIDC de Vercel (VERCEL_OIDC_TOKEN) + BLOB_STORE_ID.
# El navegador solo recibe URLs firmadas para una operación (lectura o escritura) sobre un archivo y con
# caducidad corta; nunca estos valores.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Cuota de almacenamiento por usuario en MB (500 si se deja vacía): fotografías, miniaturas, carteles,
# vídeos y pistas de audio. Con Vercel Blob Hobby (1 GB en total) conviene bajarla si hay varios usuarios.
STORAGE_USER_QUOTA_MB=

# --- IP del cliente para el rate-limit y Turnstile (MD-4) ---
# socket (por defecto): la dirección de la conexión; X-Forwarded-For nunca se tiene en cuenta.
# vercel: solo dentro de Vercel (VERCEL=1); usa X-Vercel-Forwarded-For con exactamente una IP válida
# (si no, la del socket). MD-4 sigue abierto hasta probarlo en Vercel: ver docs/despliegue.
CLIENT_IP_SOURCE=

# --- Carteles y vídeos con IA con la API key de cada usuario (BYOK, DA-67 a DA-76) ---
# Las claves las guarda cada usuario en Ajustes (cifradas con ESTATEFORGE_API_KEY_ENCRYPTION_KEY). EstateForge
# no usa ninguna clave propia para esto. 1 = añade el simulador local (no es un proveedor real; sin red ni
# cargos); se ignora en producción y en Vercel. Ver docs/producto-ia-byok.md.
AI_MEDIA_SIMULATOR=
# Milisegundos que tarda el simulador en terminar un trabajo (2500 si se deja vacío).
AI_SIMULATOR_DELAY_MS=
# Límites por usuario: generaciones a la vez, en 24 h y en 30 días (2, 20 y 200 si se dejan vacíos).
AI_MEDIA_MAX_CONCURRENT=
AI_MEDIA_DAILY_LIMIT=
AI_MEDIA_MONTHLY_LIMIT=
