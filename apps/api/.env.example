# Plantilla de apps/api/.env. Copia este fichero a .env y rellena los valores.
# No subas nunca el .env real al repositorio. Detalle de cada variable en el README.

# --- Obligatorias para arrancar la API (src/env.ts y src/db/prisma.ts) ---
# Conexión PostgreSQL. Ejemplo sin credenciales reales: postgresql://usuario:contraseña@localhost:5432/estateforge
# En un servidor remoto, añade los parámetros SSL que exija la plataforma (por ejemplo, ?sslmode=require).
DATABASE_URL=
# Pool de conexiones (opcionales): máximo (10), espera de conexión en ms (5000), inactividad en ms (30000).
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_MS=
DATABASE_IDLE_TIMEOUT_MS=
# Solo para desarrollo: contraseña de la cuenta de ejemplo de `pnpm --filter api db:seed`.
SEED_USER_PASSWORD=
# Solo para pruebas de integración: servidor PostgreSQL local con permiso para crear bases.
TEST_POSTGRES_ADMIN_URL=
# Se valida al arrancar aunque solo uses el proveedor mock u OpenAI.
GEMINI_API_KEY="tu_api_key_aqui"

# --- Opcionales (valores por defecto entre paréntesis) ---
# Origen permitido por CORS: la URL de la web (http://localhost:5173).
CORS_ORIGIN="http://localhost:5173"
# URL de la web en los enlaces de los correos (http://localhost:5173).
WEB_APP_URL="http://localhost:5173"
# URL pública de la API en el enlace del aviso de incidente (http://localhost:3000).
API_PUBLIC_URL="http://localhost:3000"
# Validada en src/env.ts (gemini), pero el código actual no la usa: el proveedor se elige en cada generación.
AI_PROVIDER="gemini"
# Clave del servidor para OpenAI. Sin ella, para usar OpenAI hay que indicar una clave al generar.
OPENAI_API_KEY=""

# Clave maestra para cifrar las API keys que los usuarios decidan guardar.
# Debe tener exactamente 32 bytes, codificados en base64 o en hexadecimal.
ESTATEFORGE_API_KEY_ENCRYPTION_KEY="tu_api_key_encryption_key_aqui"

# --- Correo (obligatorias para enviar emails; si falta alguna, el envío falla) ---
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
# Remitente, por ejemplo: EstateForge <no-reply@tu-dominio.com>
SMTP_FROM=""
# Puerto SMTP (587). SMTP_SECURE: true o false; si se deja vacío, true solo con el puerto 465.
SMTP_PORT="587"
SMTP_SECURE=""
# Contacto de soporte que se añade a algunos correos (opcional).
SUPPORT_EMAIL=""

# --- Cloudflare Turnstile (opcional; vacío = sin verificación, para desarrollo) ---
TURNSTILE_SECRET_KEY=""
# Si se indica, rechaza tokens de otro hostname. Ejemplo: app.example.com
TURNSTILE_EXPECTED_HOSTNAME=""

# --- Verificación del email (Fase 0) ---
# Fecha ISO 8601 con zona horaria desde la que las cuentas nuevas deben verificar su email
# antes de acceder. Las creadas antes son "existentes". Vacía: no se exige a nadie.
EMAIL_VERIFICATION_REQUIRED_FROM=""
# Fecha ISO 8601 hasta la que las cuentas existentes sin verificar pueden seguir entrando.
# Vacía: el periodo de gracia no termina. Requiere EMAIL_VERIFICATION_REQUIRED_FROM.
EMAIL_VERIFICATION_GRACE_UNTIL=""
# Horas de validez del enlace de verificación, de 1 a 168 (24).
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=""

# --- Entorno (development) ---
# Con production, la cookie de sesión lleva Secure (requiere HTTPS).
NODE_ENV="development"
