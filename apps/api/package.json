{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run --no-file-parallelism --exclude \"src/integration/**\"",
    "test:integration": "vitest run --no-file-parallelism src/integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "storage:cleanup": "tsx scripts/storage-cleanup.ts"
  },
  "dependencies": {
    "@estateforge/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@google/genai": "^2.17.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@vercel/blob": "2.8.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "nodemailer": "^10.0.12",
    "openai": "^7.4.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.9.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  }
}
