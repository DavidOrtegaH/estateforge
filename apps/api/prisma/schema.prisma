

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  password            String
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  securityHoldAt      DateTime? @db.Timestamptz(3)
  securityHoldVersion Int                 @default(0)
  // Recuperación obligatoria tras un incidente (E2). NULL = flujo normal / sin destino conocido.
  // securityRecoveryEmail es el destino propuesto; solo queda autorizado cuando lo confirma un OWNER.
  passwordResetRequiredAt DateTime? @db.Timestamptz(3)
  securityRecoveryEmail   String?
  adminSuspendedAt    DateTime? @db.Timestamptz(3)
  adminSuspensionReason String?
  role                String              @default("USER")
  // Verificación del email (Fase 0). NULL = sin verificar; nunca se rellena sin que el titular
  // confirme un enlace enviado a ese email. Las cuentas existentes no se marcan como verificadas.
  emailVerifiedAt     DateTime? @db.Timestamptz(3)
  // Último enlace de verificación emitido. Se reserva con una escritura condicional atómica
  // (un enlace por minuto como mucho) que serializa por cuenta la emisión de enlaces.
  emailVerificationSentAt DateTime? @db.Timestamptz(3)
  emailVerificationTokens EmailVerificationToken[]
  properties          Property[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailChangeVerifications EmailChangeVerification[]
  securityIncidentTokens SecurityIncidentToken[]
  aiKeys              UserAIKey[]
  audioTracks         AudioTrack[]
  uploadAttempts      UploadAttempt[]
  aiMediaPreference   AiMediaPreference?
  aiMediaJobs         AiMediaJob[]
  aiProviderTrials    AiProviderTrial[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  // 'SELF_SERVICE' (flujo normal) o 'SECURITY_RECOVERY' (obligatorio tras un incidente, E2).
  // Un token obligatorio lleva deliverTo y securityHoldVersion; uno normal los deja a NULL.
  // La emisión de un token normal no debe eliminar un token obligatorio pendiente.
  purpose             String  @default("SELF_SERVICE")
  deliverTo           String?
  securityHoldVersion Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}



model EmailChangeVerification {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  codeHash  String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}


// Enlace de verificación del email (Fase 0): solo se guarda el hash del token. `email` es la
// dirección a la que se envió; si la cuenta cambia de email, el token deja de servir.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  email     String
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model SecurityIncidentToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  // Email al que se envió el enlace de incidente. Es un dato del incidente, no una
  // autorización: el destino de la recuperación lo confirma un OWNER (E2).
  notifiedEmail String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserAIKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  /// BYOK (DA-68): metadatos no secretos. keyHint son los 4 últimos caracteres (no reversible); el
  /// algoritmo y la versión de cifrado permiten rotar el esquema sin perder las claves guardadas.
  keyHint           String?
  algorithm         String    @default("aes-256-gcm")
  encryptionVersion Int       @default(1)
  status            String    @default("unverified")
  lastVerifiedAt    DateTime? @db.Timestamptz(3)
  lastErrorCode     String?
  /// Varias conexiones del mismo proveedor (DA-83): etiqueta personal. Vacía: la conexión principal.
  label             String    @default("")
  /// Diagnóstico de la última comprobación (DA-87), en JSON y sin secretos: método, modelos del catálogo
  /// que la cuenta lista o no y código de error normalizado. Nunca guarda la respuesta del proveedor.
  lastCheckDetails  String?

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trials AiProviderTrial[]

  @@unique([userId, provider, label])
  @@index([userId])
}

model Property {
  id                    String       @id @default(cuid())
  title                 String
  operation             String
  type                  String
  price                 Decimal      @db.Decimal(12, 2)
  address               String
  city                  String
  neighborhood          String
  area                  Float
  bedrooms              Int
  bathrooms             Int
  floor                 Int?
  condition             String
  commercialStatus      String?
  elevator              Boolean      @default(false)
  terrace               Boolean      @default(false)
  balcony               Boolean      @default(false)
  garage                Boolean      @default(false)
  storageRoom           Boolean      @default(false)
  pool                  Boolean      @default(false)
  garden                Boolean      @default(false)
  airConditioning       Boolean      @default(false)
  heating               Boolean      @default(false)
  additionalInformation String
  userId                String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  user                  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  generations           Generation[]
  photos                PropertyPhoto[]
}

model Generation {
  id           String   @id @default(cuid())
  title        String
  description  String
  highlights   String
  callToAction String?
  provider     String
  tone         String
  language     String
  propertyId   String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  publications ListingPublication[]
  media        ListingMedia[]
  templateDraws MediaTemplateDraw[]
  aiMediaJobs   AiMediaJob[]
}

/// Fotografía de un inmueble (hasta 50, DA-51). El archivo y su miniatura están en el almacenamiento
/// de objetos (src/storage); aquí solo sus claves y sus metadatos. Restricciones manuales (posición
/// 0-49, una sola principal, límite de 50 y cola de limpieza) en prisma/postgresql/constraints.sql.
model PropertyPhoto {
  id           String   @id @default(cuid())
  propertyId   String
  storageKey   String   @unique
  originalName String?
  contentType  String
  size         Int
  width        Int
  height       Int
  sha256       String
  position     Int
  isPrimary    Boolean  @default(false)
  /// Miniatura JPEG que genera la web (lado mayor 480 px). Opcional: sin ella se sirve la original.
  thumbKey     String?  @unique
  thumbSize    Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sha256])
  @@index([propertyId, position])
}

/// Material publicitario de un anuncio: un cartel ('poster') y un vídeo ('video') como máximo.
/// Se genera en el navegador a partir de la fuente que entrega la API (sourceHash) y se sustituye
/// de forma segura: clave nueva, cambio de referencia con control de versión y limpieza diferida.
model ListingMedia {
  id           String     @id @default(cuid())
  generationId String
  kind         String
  storageKey   String     @unique
  contentType  String
  size         Int
  width        Int
  height       Int
  durationMs   Int?
  variant      Int
  sourceHash   String
  photoIds     String
  version      Int        @default(1)
  /// Cartel (DA-52): plantilla realmente usada, su versión y cómo se eligió (manual o aleatoria).
  /// NULL en los carteles anteriores a las plantillas.
  templateId      String?
  templateVersion Int?
  selectionMode   String?
  /// Vídeo (DA-54): MIME con códecs, audio incorporado y su origen. audioTrackId no es una clave
  /// ajena: borrar la pista de la biblioteca no altera los vídeos que ya la llevan dentro.
  codecs          String?
  hasAudio        Boolean    @default(false)
  audioSource     String     @default("none")
  audioTrackId    String?
  audioName       String?
  audioVolume     Int?
  audioFadeInMs   Int?
  audioFadeOutMs  Int?
  /// IA (DA-72): «classic» o «ai». Con «ai», el trabajo aceptado y su proveedor y modelo.
  generationMode  String     @default("classic")
  aiJobId         String?
  aiProvider      String?
  aiModel         String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, kind])
}

/// Sorteo de plantilla para la opción «Aleatoria» (DA-52): lo hace la API con crypto.randomInt; el
/// cartel solo puede guardarse como aleatorio con un sorteo propio, no usado y reciente.
model MediaTemplateDraw {
  id              String     @id @default(cuid())
  generationId    String
  templateId      String
  templateVersion Int
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  usedAt          DateTime?  @db.Timestamptz(3)

  generation      Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId, createdAt])
}

/// Pista de audio de la biblioteca personal (DA-55). El archivo está en el almacenamiento de objetos;
/// aquí sus metadatos. Reutilizable en los vídeos de cualquier anuncio del mismo usuario.
model AudioTrack {
  id           String   @id @default(cuid())
  userId       String
  storageKey   String   @unique
  name         String
  format       String
  contentType  String
  size         Int
  durationMs   Int
  sha256       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sha256])
  @@index([userId, createdAt])
}

/// Archivos del almacenamiento de objetos que ya no tienen referencia y deben borrarse. Los
/// añaden triggers al borrar o sustituir una fotografía o un material (también en cascada);
/// el borrado se intenta tras el commit y, si falla, la fila queda para reintentarlo.
model StorageCleanup {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  storageKey String   @unique
  reason     String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @db.Timestamptz(3)
}

/// Registro manual de dónde ha publicado el usuario un anuncio. EstateForge no publica en los portales.
model ListingPublication {
  id           String     @id @default(cuid())
  generationId String
  platform     String
  /// '' en los portales del catálogo; clave estable de la fila en «Otro/a».
  instanceKey  String     @default("")
  isPublished  Boolean    @default(false)
  url          String?
  customName   String?
  homeUrl      String?
  position     Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, platform, instanceKey])
}



model AdminAuditLog {
  id          String   @id @default(cuid())
  // NULL: acción sin un actor autenticado (p. ej., la solicitud pública de un enlace de recuperación).
  actorUserId String?
  targetUserId String?
  action      String
  reason      String?
  metadata    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

/// Intento de subida directa (DA-58): el navegador sube el archivo al almacenamiento con una URL
/// firmada (su clave, tipo, tamaño máximo y 15 minutos, sin sobrescribir) y después lo confirma. Mientras está pendiente reserva su tamaño en la
/// cuota del usuario y su hueco en la galería. La clave la genera la API; nunca el navegador.
model UploadAttempt {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  storageKey   String    @unique
  contentType  String
  size         Int
  propertyId   String?
  photoId      String?
  generationId String?
  metadata     String    @default("{}")
  status       String    @default("pending")
  expiresAt    DateTime  @db.Timestamptz(3)
  resultId     String?
  failure      String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([propertyId, status])
  @@index([status, expiresAt])
}

/// Proveedor y modelo predeterminados de cada usuario para los carteles y los vídeos con IA (DA-69).
/// Solo se aceptan combinaciones del registro de la API y proveedores con credencial guardada.
model AiMediaPreference {
  userId         String   @id
  posterProvider String?
  posterModel    String?
  videoProvider  String?
  videoModel     String?
  /// Texto del anuncio (DA-77): mismo criterio que carteles y vídeos.
  textProvider   String?
  textModel      String?
  /// Conexión concreta de cada uso (DA-83). NULL: la única conexión del proveedor.
  textKeyId      String?
  posterKeyId    String?
  videoKeyId     String?
  /// Clasificador de seguridad externo para proveedores que no traen uno (DA-85), con la clave del usuario.
  moderationProvider String?
  moderationKeyId    String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Trabajo de generación con IA (DA-71): persistente, consultado por sondeo y revisado por el usuario.
/// Hace de registro de uso: distingue solicitado, enviado, terminado, bloqueado, error y cancelado.
/// Nunca guarda la API key, prompts completos ni binarios: el resultado va al almacenamiento privado.
model AiMediaJob {
  id                    String    @id @default(cuid())
  userId                String
  generationId          String
  propertyId            String
  kind                  String
  provider              String
  model                 String
  status                String    @default("pending")
  idempotencyKey        String
  sourceHash            String
  expectedVersion       Int
  /// Parámetros no secretos: fotografías de referencia, duración, resolución, audio elegido.
  params                String    @default("{}")
  providerOperationId   String?
  resultKey             String?   @unique
  resultContentType     String?
  resultSize            Int?
  moderationStatus      String    @default("pending")
  moderationCategory    String?
  failureCode           String?
  estimatedCostMicroUsd Int?
  pollCount             Int       @default(0)
  lastPolledAt          DateTime? @db.Timestamptz(3)
  submittedAt           DateTime? @db.Timestamptz(3)
  completedAt           DateTime? @db.Timestamptz(3)
  expiresAt             DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([generationId, kind, status])
  @@index([status, expiresAt])
}

/// Prueba real controlada de un proveedor (DA-89): una sola operación con datos sintéticos, iniciada y
/// confirmada por el usuario con su propia conexión, tras ver el proveedor, el modelo y el coste. No está
/// ligada a ningún inmueble ni anuncio y su resultado no se guarda: solo el informe de la validación.
model AiProviderTrial {
  id                    String    @id @default(cuid())
  userId                String
  /// Conexión usada. Si el usuario la elimina, la prueba se conserva sin ella.
  connectionId          String?
  provider              String
  model                 String
  /// text | poster | video
  kind                  String
  status                String    @default("pending")
  idempotencyKey        String
  durationSeconds       Int?
  /// Coste estimado que el usuario vio y aceptó (NULL: no verificable).
  estimatedCostMicroUsd Int?
  /// Versión del contrato del adaptador con la que se ejecutó.
  contractVersion       String
  /// Clasificador externo usado (proveedor:conexión), si el proveedor de generación no modera.
  moderationProvider    String?
  moderationKeyId       String?
  providerOperationId   String?
  failureCode           String?
  /// Informe de la validación en JSON, sin secretos ni URL del proveedor.
  report                String    @default("{}")
  pollCount             Int       @default(0)
  lastPolledAt          DateTime? @db.Timestamptz(3)
  submittedAt           DateTime? @db.Timestamptz(3)
  completedAt           DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection UserAIKey? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status])
}
