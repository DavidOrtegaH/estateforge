

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  password            String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  securityHoldAt      DateTime?
  securityHoldVersion Int                 @default(0)
  adminSuspendedAt    DateTime?
  adminSuspensionReason String?
  role                String              @default("USER")
  properties          Property[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailChangeVerifications EmailChangeVerification[]
  securityIncidentTokens SecurityIncidentToken[]
  aiKeys              UserAIKey[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}



model EmailChangeVerification {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}


model SecurityIncidentToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserAIKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Property {
  id                    String       @id @default(cuid())
  title                 String
  operation             String
  type                  String
  price                 Float
  address               String
  city                  String
  neighborhood          String
  area                  Float
  bedrooms              Int
  bathrooms             Int
  floor                 Int?
  condition             String
  elevator              Boolean      @default(false)
  terrace               Boolean      @default(false)
  balcony               Boolean      @default(false)
  garage                Boolean      @default(false)
  storageRoom           Boolean      @default(false)
  pool                  Boolean      @default(false)
  garden                Boolean      @default(false)
  airConditioning       Boolean      @default(false)
  heating               Boolean      @default(false)
  additionalInformation String
  userId                String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  generations           Generation[]
}

model Generation {
  id           String   @id @default(cuid())
  title        String
  description  String
  highlights   String
  callToAction String?
  provider     String
  tone         String
  language     String
  propertyId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}



model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  targetUserId String?
  action      String
  reason      String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}
