{
  "name": "estateforge",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "node scripts/dev/postgres-wsl.mjs start && pnpm run dev:apps",
    "dev:apps": "pnpm --parallel --filter api --filter web dev",
    "db:dev:start": "node scripts/dev/postgres-wsl.mjs start",
    "db:dev:status": "node scripts/dev/postgres-wsl.mjs status",
    "db:dev:stop": "node scripts/dev/postgres-wsl.mjs stop",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "lint": "oxlint",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm --filter @estateforge/shared typecheck && pnpm --filter api typecheck && pnpm --filter web typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:shared": "pnpm --filter @estateforge/shared test",
    "test:dev": "vitest run --root scripts/dev",
    "test:scripts": "vitest run --root scripts",
    "check:commits": "node scripts/git/check-commit-messages.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "^3.0.0"
  }
}
